PATTYOPS_DATABASE_PATH=/app/data/pattyops.db
PATTYOPS_CLOUD_URL=https://pattyops.example.com
PATTYOPS_DEVICE_ID=kitchen-01
PATTYOPS_DEVICE_TOKEN=replace_with_the_same_device_token_as_the_cloud
PATTYOPS_SYNC_BATCH_SIZE=100
PATTYOPS_SYNC_INTERVAL_SECONDS=5
PATTYOPS_SYNC_TIMEOUT_SECONDS=15

# Set true only when testing against an HTTP endpoint on a trusted private network.
PATTYOPS_ALLOW_INSECURE_HTTP=false
