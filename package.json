{
  "name": "pattyops",
  "version": "0.1.0",
  "private": true,
  "description": "Local YOLO patty lifecycle tracking and event logging",
  "packageManager": "bun@1.1.42",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-pattyops.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-pattyops.ps1 -SetupOnly && .venv/Scripts/python.exe -m pip install -r requirements-cloud.txt",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-pattyops.ps1 -ValidateOnly",
    "webcam": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-pattyops.ps1 -Source 0",
    "video": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-pattyops.ps1 -Source input/Patty4.mp4 -SaveVideo output/Patty4-annotated.mp4",
    "events": ".venv/Scripts/python.exe pattyops.py events --db Database/pattyops.db --limit 100",
    "test": ".venv/Scripts/python.exe -m unittest -v test_pattyops.py test_cloud_api.py test_edge_sync.py test_production_flow.py",
    "docker:validate": "docker compose config --quiet",
    "docker:video": "docker compose up --build --abort-on-container-exit --exit-code-from pattyops",
    "docker:down": "docker compose down --remove-orphans",
    "deploy:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./configure-deployment.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy-local.ps1",
    "deploy:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy-local.ps1 -SkipBuild -SyncOnce",
    "deploy:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./stop-local-deployment.ps1"
  },
  "engines": {
    "bun": ">=1.1.42"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
