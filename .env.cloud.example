POSTGRES_DB=pattyops
POSTGRES_USER=pattyops
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
PATTYOPS_CLOUD_DATABASE_URL=postgresql+psycopg://pattyops:replace_with_a_long_random_database_password@postgres:5432/pattyops
PATTYOPS_CLOUD_BIND_ADDRESS=127.0.0.1
PATTYOPS_CLOUD_PORT=8000

# One unique token per kitchen device. Each token must contain at least 16 characters.
PATTYOPS_DEVICE_TOKENS_JSON={"kitchen-01":"replace_with_a_long_random_device_token"}
